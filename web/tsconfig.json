{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"jsx": "react-jsx",
		"jsxImportSource": "preact",
		"lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
		"types": []
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"]
}
