# Optional for localhost; set the exact HTTPS origin for private remote access.
PUBLIC_ORIGIN=
PORT=4310
# Base for relative session paths; blank uses the account's home directory.
# Absolute paths and ~/ paths may point anywhere the account can access.
PROJECTS_ROOT=
# Advanced overrides; relative paths resolve from the checkout.
# STATE_DIR=
# DIST_DIR=
# TMUX_SOCKET=
# DEV_ORIGIN=http://127.0.0.1:5173
# Agent executables: an executable path (not a shell command) or PATH name.
# Authenticate Codex on the host; configure the DeepSeek key privately on the host.
OPENCODE_BIN=opencode
CODEX_BIN=codex
DEEPSEEK_BIN=dsh-tui
PI_BIN=pi
# Optional Pi 0.85.1 lifecycle observation for new launches only.
# PI_ATTENTION=1
# PI_CODING_AGENT_DIR=/home/your-user/.pi/agent
# Backend home overrides must be absolute paths; no shell expansion is performed.
# CODEX_HOME=/home/your-user/.codex
# DSH_HOME=/home/your-user/.dsh
# DEEPSEEK_API_KEY=your-private-key
